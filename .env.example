# Public application identity
NEXT_PUBLIC_APP_NAME=SecureNet
NEXT_PUBLIC_DEMO_MODE=true

# Required for the Sprint 1 Demo session signer. Use at least 32 random characters.
# Never expose this value through a NEXT_PUBLIC_* variable.
AUTH_SECRET=

# Demo-only password. Local development may use the documented fixture value.
# Production must set this privately; never use a NEXT_PUBLIC_* variable.
SEED_DEMO_PASSWORD=

# Required Sprint 2 PostgreSQL connections. Use separate databases.
# DATABASE_URL must target the development database.
# TEST_DATABASE_URL must target exactly securenet_test.
DATABASE_URL=
TEST_DATABASE_URL=

# Runtime policy: local, test, or production-demo.
SECURENET_DEPLOYMENT_ENV=local

# Server-only free portfolio flag. Use only with the documented production-demo
# policy and an external Neon database; never expose it as NEXT_PUBLIC_*.
SECURENET_PORTFOLIO_MODE=false

# Production Demo defaults to Viewer-only. This server-only override privately
# enables Administrator and Network Engineer login when explicitly required.
DEMO_PRIVATE_ROLE_LOGIN_ENABLED=false

# Guarded, one-time, empty-only production Demo bootstrap. Leave disabled.
ALLOW_PRODUCTION_DEMO_BOOTSTRAP=false
SECURENET_PRODUCTION_DATABASE_NAME=

# Guarded, manual, empty-only Neon portfolio bootstrap. Leave disabled during
# normal application startup and deployment.
ALLOW_PORTFOLIO_BOOTSTRAP=false
SECURENET_PORTFOLIO_DATABASE_NAME=

# Structured application log threshold: debug, info, warn, or error.
LOG_LEVEL=info
